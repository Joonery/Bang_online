[Unit]
Description=BANG Online Board Game
After=network.target

[Service]
Type=simple
User=banggame
Group=banggame
WorkingDirectory=/opt/bang-online
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node /opt/bang-online/server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bang-online

[Install]
WantedBy=multi-user.target
